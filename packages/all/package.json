{
  "name": "@textguard/all",
  "version": "1.0.1",
  "description": "Complete TextGuard bundle",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@textguard/core": "workspace:*",
    "@textguard/plugin-fa": "workspace:*",
    "@textguard/plugin-en": "workspace:*",
    "@textguard/plugin-ar": "workspace:*",
    "@textguard/plugin-email": "workspace:*",
    "@textguard/plugin-url": "workspace:*",
    "@textguard/plugin-phone": "workspace:*",
    "@textguard/plugin-ip": "workspace:*",
    "@textguard/plugin-uuid": "workspace:*",
    "@textguard/plugin-credit-card": "workspace:*",
    "@textguard/plugin-iban": "workspace:*"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2"
  }
}
