{
  "name": "@textguard/plugin-iban",
  "version": "1.0.1",
  "description": "Official iban Detection Plugin for TextGuard",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "lint": "eslint .",
    "test": "vitest"
  },
  "dependencies": {
    "@textguard/core": "workspace:*"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2",
    "vitest": "^4.1.8"
  },
  "sideEffects": false
}
