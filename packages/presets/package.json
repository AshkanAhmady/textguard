{
  "name": "@textguard/presets",
  "version": "1.0.0",
  "description": "Official presets for TextGuard",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "lint": "eslint .",
    "test": "vitest"
  },
  "dependencies": {
    "@textguard/core": "workspace:*",
    "@textguard/plugin-credit-card": "workspace:*",
    "@textguard/plugin-email": "workspace:*",
    "@textguard/plugin-iban": "workspace:*",
    "@textguard/plugin-ip": "workspace:*",
    "@textguard/plugin-phone": "workspace:*",
    "@textguard/plugin-url": "workspace:*",
    "@textguard/plugin-uuid": "workspace:*"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2",
    "vitest": "^4.1.8"
  },
  "sideEffects": false
}
