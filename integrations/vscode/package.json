{
  "name": "textguard-vscode",
  "displayName": "TextGuard",
  "description": "Scan editor content with TextGuard and surface matches as diagnostics with Explain actions.",
  "version": "0.1.0",
  "private": true,
  "publisher": "textguard",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AshkanAhmady/textguard.git",
    "directory": "integrations/vscode"
  },
  "homepage": "https://github.com/AshkanAhmady/textguard#readme",
  "bugs": {
    "url": "https://github.com/AshkanAhmady/textguard/issues"
  },
  "keywords": ["textguard", "lint", "profanity", "pii", "content-moderation"],
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Linters", "Other"],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:textguard.scanActiveEditor",
    "onCommand:textguard.explainDiagnostic"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "textguard.scanActiveEditor",
        "title": "TextGuard: Scan Active Editor"
      },
      {
        "command": "textguard.explainDiagnostic",
        "title": "TextGuard: Explain Match"
      }
    ],
    "configuration": {
      "title": "TextGuard",
      "properties": {
        "textguard.scanOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically scan a document with TextGuard when it is saved."
        },
        "textguard.preset": {
          "type": "string",
          "enum": ["strict", "enterprise", "socialMedia"],
          "default": "strict",
          "description": "TextGuard preset used for editor scans and explanations."
        },
        "textguard.whitelist": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "uniqueItems": true,
          "description": "Words that TextGuard should allow and omit from editor diagnostics."
        }
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit",
    "package:vsix": "npm run build && vsce package --out textguard-vscode-${npm_package_version}.vsix"
  },
  "dependencies": {
    "@textguard/all": "^1.0.3"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.6.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2"
  }
}
