{
  "name": "textguard-vscode",
  "displayName": "TextGuard",
  "description": "Scan the active editor with TextGuard and surface matches as VS Code diagnostics.",
  "version": "0.1.0",
  "private": true,
  "publisher": "textguard",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Linters"],
  "activationEvents": ["onCommand:textguard.scanActiveEditor"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [{ "command": "textguard.scanActiveEditor", "title": "TextGuard: Scan Active Editor" }]
  },
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@textguard/all": "^1.0.3",
    "@textguard/core": "^1.0.3"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2"
  }
}
