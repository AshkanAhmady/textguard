{
  "name": "textguard-vscode",
  "displayName": "TextGuard",
  "description": "Scan the active editor with TextGuard and surface matches as VS Code diagnostics.",
  "version": "0.1.0",
  "private": true,
  "publisher": "textguard",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Linters"],
  "activationEvents": ["onStartupFinished", "onCommand:textguard.scanActiveEditor"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "textguard.scanActiveEditor",
        "title": "TextGuard: Scan Active Editor"
      }
    ],
    "configuration": {
      "title": "TextGuard",
      "properties": {
        "textguard.scanOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically scan a document with TextGuard when it is saved."
        }
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@textguard/all": "^1.0.3"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2"
  }
}
